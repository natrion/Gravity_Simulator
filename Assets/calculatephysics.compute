//function that prepares the data for the next frame
[numthreads(NUM_OF_THREADS, 1, 1)]
void PrepareData(uint3 id : SV_DispatchThreadID)
{   
    
    if (id.x < ChunksIn.Length)
    {
        ChunksIn[id.x] = ChunksOut[id.x];//copying the chunks data to the output buffer
        //resetting the chunks data for the next frame
        /*
        if  (ChunksOut[id.x].iteration == 0)
        {
            ChunksOut[id.x].numofPoints = 0;
            ChunksOut[id.x].startPointId = -1;
            ChunksOut[id.x].endPointId = -1;
        }*/
    }else if  (id.x < ChunksIn.Length+ pointsIn.Length)      
    {
        pointsIn[id.x - ChunksIn.Length] = pointsOut[id.x - ChunksIn.Length];//copying the points data to the output buffer
    }
}